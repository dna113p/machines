{
  "name": "@dna113p/machines",
  "version": "0.1.0",
  "description": "Reusable workflows coordinating agents, local operations, and human decisions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dna113p/machines.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "machine": "./dist/src/cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./acp": { "types": "./dist/src/acp.d.ts", "import": "./dist/src/acp.js" },
    "./launcher": { "types": "./dist/src/launcher.d.ts", "import": "./dist/src/launcher.js" },
    "./mcp": { "types": "./dist/mcp/server.d.ts", "import": "./dist/mcp/server.js" },
    "./pi-extension": { "types": "./dist/pi-extension/index.d.ts", "import": "./dist/pi-extension/index.js" }
  },
  "files": ["dist", "docs/architecture.md", "docs/authoring.md", "docs/integrations.md", "skills", "LICENSE", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "check": "npm run typecheck && npm test",
    "example": "node examples/operation.ts",
    "example:agents": "node examples/named-agents.ts",
    "example:host": "node examples/host.ts",
    "example:pi": "node examples/pi.ts",
    "mcp": "node mcp/server.ts",
    "prepack": "npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:plugin": "node scripts/smoke-plugin.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "^1.3.7",
    "valibot": "^1.4.2",
    "xstate": "^5.32.6",
    "yocto-spinner": "^1.2.2",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
